{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "welldium": {
      "type": "streamable-http",
      "url": "https://test.welldium.com/api/partner/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://test.welldium.com/api/auth/oauth/auth",
            "tokenUrl": "https://test.welldium.com/api/auth/oauth/token",
            "baseScopes": ["practitioner_public:read", "practitioner_public:write"]
          }
        }
      }
    }
  }
}
